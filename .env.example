# Namuna fayl. Nusxa oling: .env.example -> .env va o'z qiymatlaringizni yozing.
# ⚠️ Haqiqiy token/parolni SHU faylga yozmang — u ulashish uchun mo'ljallangan.

# ─────────── BOT ───────────
BOT_TOKEN=8643378046:AAF3VyM6OtHJ4ZkYh7AM5YvFnEQUAA0-o7A
MAIN_ADMIN_ID=8837120659
ADMIN_PASSWORD=09092

# ─────────── BAZA ───────────
# Lokal ishlab chiqishda — oddiy SQLite fayl:
DB_PATH=kinoBaza.db

# Render/bulutda — Turso (bepul, doimiy). Bo'lsa DB_PATH e'tiborsiz qoladi:
# TURSO_DATABASE_URL=libsql://sizning-baza-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# ─────────── IXTIYORIY ───────────
# Render $PORT ni o'zi beradi; lokalda health-server shu portda:
PORT=8080
# Zayavka kanalga kelgan so'rovni bot avtomatik tasdiqlasinmi
AUTO_APPROVE=false
# Kinolarni forward/saqlashdan himoya qilish
PROTECT_CONTENT=false
# Obuna tekshiruvi keshi (soniya) — trafikni tejaydi
SUB_CACHE_TTL=600
